# Copiar a .env y ajustar si hace falta. Todos los valores tienen un default
# razonable (relativo a la raíz del repositorio) si no se define la variable.

# --- Modelo final (NB12): el .pkl se resuelve desde la especificación ---
# DIRECTORIO_MODELOS=../models
# RUTA_ESPECIFICACION_NB12=../reports/results/nb12_especificacion.json
# RUTA_METRICAS_NB12=../reports/results/nb12_metricas.json

# --- Tendencia de exposición (NB05) ---
# RUTA_ESPECIFICACION_NB05=../reports/results/nb05_especificacion_v2.json

# --- Datos base (catálogo de distritos, clima, terciles) ---
# RUTA_MATRIZ_FRECUENCIA=../data/processed/matriz_frecuencia_v3.csv.gz
# RUTA_CENSO_POBLACION=../data/raw/TAB_POB_AREA_1.xlsx
# RUTA_PARQUE_VEHICULAR=../data/raw/parque_vehicular_onasevi.csv
# RUTA_SINIESTROS=../data/raw/siniestros.csv
# RUTA_FERIADOS=../data/raw/feriados_elsalvador_2022_2026.xlsx

# --- GeoJSON de distritos (puede no existir: ver README) ---
# RUTA_GEOJSON_DISTRITOS=../data/geo/distritos.geojson

# --- Validación de rango de fechas ---
# FECHA_MINIMA=2022-01-01
# FECHA_MAXIMA=2100-12-31
# MAX_DIAS_POR_RANGO=366

# --- CORS: orígenes permitidos (lista JSON). Default: http://localhost:4200 ---
# CORS_ORIGENES=["http://localhost:4200"]

# --- Logging ---
# NIVEL_LOG=INFO
